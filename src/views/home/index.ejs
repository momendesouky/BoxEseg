<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BoxEseg | Fine Paper &amp; Desk Tools</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --latte:#FAF6EF; --latte-2:#F0E9DD; --card:#FFFDF8;
      --espresso:#2B2018; --mocha:#6A5446; --caramel:#C1784F; --caramel-deep:#A25E3C;
      --line:rgba(43,32,24,.12); --line-2:rgba(43,32,24,.26);
      --shadow:0 24px 50px -22px rgba(43,32,24,.22);
      --shadow-sm:0 12px 26px -14px rgba(43,32,24,.18);
      --serif:'Playfair Display',Georgia,serif; --sans:'Inter',-apple-system,'Segoe UI',Arial,sans-serif;
      --r:16px; --r-sm:10px;
    }
    *{margin:0;padding:0;box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{font-family:var(--sans);background:var(--latte);color:var(--espresso);line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    a{text-decoration:none;color:inherit;transition:color .25s ease}
    img{display:block;max-width:100%}
    ul{list-style:none}
    button{font:inherit;cursor:pointer}
    input,select,textarea{font:inherit;color:inherit}
    ::selection{background:var(--caramel);color:#fff}

    .container{width:100%;max-width:1240px;margin:0 auto;padding:0 24px}

    /* ================= Topbar ================= */
    .topbar{position:sticky;top:0;z-index:200;background:rgba(250,246,239,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
    .topbar-inner{display:flex;align-items:center;justify-content:space-between;gap:24px;height:74px}
    .brand{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-size:1.55rem;font-weight:700}
    .brand-mark{width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,var(--caramel) 50%,var(--espresso) 50%);box-shadow:0 0 0 2px var(--espresso);transform:rotate(-6deg)}
    .brand span{color:var(--caramel)}
    .site-nav{display:flex;align-items:center;gap:6px}
    .site-nav a{padding:9px 15px;border-radius:999px;font-size:.9rem;font-weight:500;color:var(--mocha)}
    .site-nav a:hover{color:var(--espresso);background:var(--latte-2)}
    .site-nav a.active{background:var(--espresso);color:var(--latte)}
    .nav-actions{display:flex;align-items:center;gap:12px}
    .nav-actions .ghost{font-size:.9rem;font-weight:600}
    .nav-actions .ghost:hover{color:var(--caramel)}
    .menu-toggle{display:none;flex-direction:column;justify-content:center;gap:5px;width:42px;height:42px;background:transparent;border:1px solid var(--line);border-radius:10px}
    .menu-toggle span{display:block;width:18px;height:2px;background:var(--espresso);margin:0 auto;transition:.3s}
    .menu-toggle.open span:nth-child(1){transform:translateY(3.5px) rotate(45deg)}
    .menu-toggle.open span:nth-child(2){transform:translateY(-3.5px) rotate(-45deg)}
    .mobile-menu{position:fixed;inset:74px 0 auto 0;z-index:190;background:var(--latte);border-bottom:1px solid var(--line);padding:18px 24px 26px;display:none}
    .mobile-menu.open{display:grid;gap:6px}
    .mobile-menu a{padding:13px 10px;border-radius:10px;font-size:1.05rem;font-weight:600}
    .mobile-menu a:hover{background:var(--latte-2)}
    .mobile-menu .auth-row{display:flex;gap:10px;margin-top:10px}

    /* ================= Buttons ================= */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 24px;border-radius:999px;border:1px solid var(--espresso);font-size:.9rem;font-weight:600;transition:all .22s ease;background:transparent;color:var(--espresso)}
    .btn-primary{background:var(--espresso);color:var(--latte)}
    .btn-primary:hover{background:var(--caramel);border-color:var(--caramel);transform:translateY(-2px);box-shadow:0 12px 24px -12px rgba(193,120,79,.7)}
    .btn-outline:hover{background:var(--espresso);color:var(--latte);transform:translateY(-2px)}
    .btn-sm{min-height:38px;padding:0 16px;font-size:.83rem}
    .btn-block{width:100%}

    /* ================= Flash ================= */
    .flash-stack{position:fixed;top:90px;right:20px;z-index:400;display:grid;gap:10px;width:min(360px,calc(100% - 40px))}
    .flash{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-radius:12px;background:var(--card);border:1px solid var(--line);box-shadow:var(--shadow-sm);animation:slideIn .35s cubic-bezier(.16,1,.3,1)}
    .flash-success{border-left:4px solid #4c9f70}
    .flash-error{border-left:4px solid #c2483e}
    .flash button{border:0;background:transparent;color:var(--mocha);font-size:1rem}
    @keyframes slideIn{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:none}}

    /* ================= Hero ================= */
    .hero{padding:110px 0 80px;position:relative}
    .hero::before{content:"";position:absolute;inset:0;background:
      radial-gradient(circle at 82% 20%,rgba(193,120,79,.14),transparent 42%),
      radial-gradient(circle at 12% 85%,rgba(43,32,24,.06),transparent 40%);pointer-events:none}
    .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center;position:relative}
    .eyebrow{display:inline-flex;align-items:center;gap:10px;text-transform:uppercase;letter-spacing:.18em;font-size:.74rem;font-weight:600;color:var(--caramel)}
    .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--caramel)}
    .hero h1{font-family:var(--serif);font-size:clamp(2.7rem,5.6vw,4.3rem);font-weight:600;line-height:1.06;margin:20px 0 24px}
    .hero h1 em{font-style:italic;color:var(--caramel)}
    .hero p{color:var(--mocha);font-size:1.1rem;max-width:520px}
    .hero-actions{display:flex;gap:14px;margin-top:36px;flex-wrap:wrap}
    .hero-media{position:relative}
    .hero-img{aspect-ratio:4/5;border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow);transform:rotate(1.5deg)}
    .hero-img::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(43,32,24,.18),transparent 40%)}
    .hero-img img{width:100%;height:100%;object-fit:cover}
    .hero-note{position:absolute;bottom:-18px;left:-18px;background:var(--espresso);color:var(--latte);padding:16px 22px;border-radius:14px;box-shadow:var(--shadow);transform:rotate(-3deg)}
    .hero-note strong{font-family:var(--serif);font-size:1.5rem;display:block;line-height:1.1}
    .hero-note span{font-size:.76rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(250,246,239,.65)}

    /* ================= Marquee ================= */
    .marquee{overflow:hidden;background:var(--espresso);color:var(--latte);padding:18px 0;border-block:1px solid rgba(43,32,24,.2)}
    .marquee-track{display:flex;gap:40px;width:max-content;animation:scroll 26s linear infinite;white-space:nowrap}
    .marquee-track span{font-family:var(--serif);font-style:italic;font-size:1.25rem;color:rgba(250,246,239,.85)}
    .marquee-track i{font-style:normal;color:var(--caramel);font-size:.8rem;letter-spacing:.1em}
    @keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

    /* ================= Sections ================= */
    section{padding:92px 0}
    .section-head{max-width:640px;margin-bottom:48px}
    .section-head.center{margin-inline:auto;text-align:center}
    .section-head h2{font-family:var(--serif);font-size:clamp(1.9rem,3.4vw,2.7rem);font-weight:600;margin:12px 0 12px}
    .section-head p{color:var(--mocha)}
    .section-head.center .eyebrow{justify-content:center}
    .section-head.center .eyebrow::before{display:none}
    .section-muted{background:var(--latte-2)}

    /* ================= Categories ================= */
    .cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    .cat-card{position:relative;display:block;padding:38px 32px;background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s ease}
    .cat-card:hover{transform:translateY(-6px);box-shadow:var(--shadow)}
    .cat-card::after{content:"";position:absolute;top:-34px;right:-34px;width:110px;height:110px;border-radius:50%;background:repeating-linear-gradient(45deg,var(--latte-2) 0 10px,transparent 10px 20px);opacity:.9}
    .cat-card .cat-num{font-family:var(--serif);font-size:.95rem;color:var(--caramel);letter-spacing:.08em}
    .cat-card h3{font-family:var(--serif);font-size:1.5rem;font-weight:600;margin:12px 0 8px}
    .cat-card p{color:var(--mocha);font-size:.93rem}
    .cat-card .cat-link{display:inline-flex;align-items:center;gap:8px;margin-top:18px;font-weight:600;font-size:.88rem;color:var(--espresso);border-bottom:1px solid var(--caramel);padding-bottom:2px}
    .cat-card .cat-link:hover{color:var(--caramel-deep)}

    /* ================= Products ================= */
    .head-row{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:40px;flex-wrap:wrap}
    .product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:28px}
    .product-card{display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s ease;opacity:0;transform:translateY(24px)}
    .product-card.reveal{opacity:1;transform:translateY(0)}
    .product-card:hover{transform:translateY(-6px);box-shadow:var(--shadow)}
    .card-media{position:relative;display:block;aspect-ratio:4/3.4;overflow:hidden;background:var(--latte-2)}
    .card-media img{width:100%;height:100%;object-fit:cover;transition:transform .5s cubic-bezier(.16,1,.3,1)}
    .product-card:hover .card-media img{transform:scale(1.06)}
    .card-media::after{content:"";position:absolute;inset:auto 0 0 0;height:42%;background:linear-gradient(to top,rgba(43,32,24,.45),transparent);opacity:0;transition:opacity .3s}
    .product-card:hover .card-media::after{opacity:1}
    .card-media .quick{position:absolute;right:14px;bottom:14px;z-index:2;padding:8px 14px;border-radius:999px;background:var(--card);font-size:.76rem;font-weight:700;letter-spacing:.04em;opacity:0;transform:translateY(8px);transition:.3s}
    .product-card:hover .quick{opacity:1;transform:none}
    .badge{position:absolute;top:14px;left:14px;z-index:2;padding:6px 12px;border-radius:999px;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}
    .badge-featured{background:var(--espresso);color:var(--latte)}
    .badge-stock{background:#e8ded1;color:var(--mocha)}
    .card-body{display:flex;flex-direction:column;gap:10px;padding:20px 20px 22px;flex:1}
    .card-cat{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.14em;color:var(--caramel)}
    .card-body h3{font-family:var(--serif);font-size:1.32rem;font-weight:600;line-height:1.2}
    .card-body h3 a:hover{color:var(--caramel-deep)}
    .card-desc{color:var(--mocha);font-size:.9rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .card-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto;padding-top:14px;border-top:1px dashed var(--line-2)}
    .price{font-family:var(--serif);font-size:1.28rem;font-weight:700}
    .price .was{font-family:var(--sans);font-size:.85rem;font-weight:400;color:var(--mocha);text-decoration:line-through;margin-left:8px}
    .stock-note{font-size:.78rem;color:var(--mocha)}
    .stock-note b{color:var(--espresso)}
    .card-actions{display:grid;grid-template-columns:1fr auto;gap:10px;margin-top:4px}

    /* ================= Story band ================= */
    .story{background:var(--espresso);color:var(--latte);overflow:hidden}
    .story .container{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
    .story .eyebrow{color:var(--caramel)}
    .story .eyebrow::before{background:var(--caramel)}
    .story h2{font-family:var(--serif);font-size:clamp(2rem,3.6vw,2.8rem);font-weight:600;margin:14px 0 18px}
    .story p{color:rgba(250,246,239,.7)}
    .story .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:36px}
    .story .step{padding:20px;border:1px solid rgba(250,246,239,.14);border-radius:14px}
    .story .step strong{font-family:var(--serif);font-size:1.3rem;display:block;margin-bottom:6px}
    .story .step span{font-size:.85rem;color:rgba(250,246,239,.62)}

    /* ================= Footer ================= */
    .site-footer{background:var(--espresso);color:var(--latte);border-top:1px solid rgba(250,246,239,.1)}
    .footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:48px;padding:72px 0 48px}
    .footer-grid h4{font-family:var(--serif);font-size:1.05rem;margin-bottom:16px}
    .footer-brand p{color:rgba(250,246,239,.62);max-width:300px;margin-top:12px}
    .footer-links{display:flex;flex-direction:column;gap:11px}
    .footer-links a{color:rgba(250,246,239,.62)}
    .footer-links a:hover{color:var(--latte)}
    .footer-bottom{border-top:1px solid rgba(250,246,239,.14);padding:22px 0;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:rgba(250,246,239,.5);font-size:.85rem}

    /* ================= Responsive ================= */
    @media(max-width:960px){
      .site-nav{display:none}
      .menu-toggle{display:flex}
      .nav-actions{display:none}
      .hero-grid{grid-template-columns:1fr;gap:56px}
      .cat-grid{grid-template-columns:1fr 1fr}
      .story .container{grid-template-columns:1fr;gap:32px}
      .footer-grid{grid-template-columns:1fr;gap:32px;padding-block:52px}
      .hero{padding:70px 0 60px}
      section{padding:68px 0}
    }
    @media(max-width:600px){
      .topbar-inner{height:66px}
      .mobile-menu{inset:66px 0 auto 0}
      .cat-grid,.product-grid{grid-template-columns:1fr}
      .hero-note{left:-6px;bottom:-14px}
      .story .steps{grid-template-columns:1fr}
      .hero-actions .btn{width:100%}
    }
  </style>
</head>
<body>

  <header class="topbar">
    <div class="container topbar-inner">
      <a href="/" class="brand"><span class="brand-mark"></span>Box<span>Eseg</span></a>

      <button class="menu-toggle" data-toggle aria-label="Toggle navigation">
        <span></span><span></span>
      </button>

      <nav class="site-nav">
        <a href="/" class="active">Home</a>
        <a href="/products">Shop</a>
        <a href="/wishlist">Wishlist</a>
        <a href="/cart">Cart</a>
        <% if (currentUser && currentUser.role === 'admin') { %>
          <a href="/dashboard">Dashboard</a>
        <% } %>
      </nav>

      <div class="nav-actions">
        <% if (currentUser) { %>
          <a class="ghost" href="/profile"><%= currentUser.firstName %></a>
          <form action="/auth/logout" method="POST" style="margin:0">
            <button class="btn btn-sm btn-outline" type="submit">Logout</button>
          </form>
        <% } else { %>
          <a class="ghost" href="/auth/login">Login</a>
          <a class="btn btn-sm btn-primary" href="/auth/register">Get started</a>
        <% } %>
      </div>
    </div>
  </header>

  <div class="mobile-menu" data-mobile>
    <a href="/" class="active">Home</a>
    <a href="/products">Shop</a>
    <a href="/wishlist">Wishlist</a>
    <a href="/cart">Cart</a>
    <% if (currentUser && currentUser.role === 'admin') { %>
      <a href="/dashboard">Dashboard</a>
    <% } %>
    <div class="auth-row">
      <% if (currentUser) { %>
        <a class="btn btn-sm btn-primary" href="/profile"><%= currentUser.firstName %></a>
        <a class="btn btn-sm btn-outline" href="/auth/logout">Logout</a>
      <% } else { %>
        <a class="btn btn-sm btn-outline" href="/auth/login">Login</a>
        <a class="btn btn-sm btn-primary" href="/auth/register">Get started</a>
      <% } %>
    </div>
  </div>

  <% if (flash && flash.length) { %>
    <div class="flash-stack">
      <% flash.forEach((item) => { %>
        <div class="flash flash-<%= item.type %>">
          <span><%= item.message %></span>
          <button type="button" data-dismiss aria-label="Dismiss">×</button>
        </div>
      <% }) %>
    </div>
  <% } %>

  <header class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Premium desk supplies</span>
        <h1>The art of <em>analog</em> thinking.</h1>
        <p>Curated journals, precise pens and paper that asks you to slow down. Tools for minds that prefer to work offline.</p>
        <div class="hero-actions">
          <a href="/products" class="btn btn-primary">Shop the collection</a>
          <a href="/products?sort=rating" class="btn btn-outline">Most loved</a>
        </div>
      </div>
      <div class="hero-media">
        <div class="hero-img">
          <img src="https://images.unsplash.com/photo-1585336261022-680e295ce3fe?auto=format&fit=crop&q=80&w=1000" alt="Fountain pen resting on a premium open notebook">
        </div>
        <div class="hero-note">
          <strong>Small-batch</strong>
          <span>curated monthly</span>
        </div>
      </div>
    </div>
  </header>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track" data-marquee>
      <span>Journals <i>✦</i></span>
      <span>Fountain pens <i>✦</i></span>
      <span>Artisan inks <i>✦</i></span>
      <span>Paper goods <i>✦</i></span>
      <span>Desk objects <i>✦</i></span>
      <span>Journals <i>✦</i></span>
      <span>Fountain pens <i>✦</i></span>
      <span>Artisan inks <i>✦</i></span>
      <span>Paper goods <i>✦</i></span>
      <span>Desk objects <i>✦</i></span>
    </div>
  </div>

  <section class="section-muted">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Curated goods</span>
        <h2>Tools for every desk</h2>
        <p>Distinct collections of analog tools, sourced from the finest paper mills and artisans.</p>
      </div>

      <div class="cat-grid">
        <% if (categories && categories.length) {
          categories.forEach((category, i) => {
            const img = category.image ? category.image : ['https://images.unsplash.com/photo-1585076641399-5c06d1b3365f?auto=format&fit=crop&q=80&w=800','https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&q=80&w=800','https://images.unsplash.com/photo-1587825140708-dfaf72ae4b04?auto=format&fit=crop&q=80&w=800'][i % 3];
        %>
          <a class="cat-card" href="/products?category=<%= category.slug %>">
            <span class="cat-num">0<%= i + 1 %> / <%= category.name %></span>
            <h3><%= category.name %></h3>
            <p><%= category.description || 'Premium writing instruments and accessories crafted for the perfect desk setup.' %></p>
            <span class="cat-link">Shop <%= category.name %> →</span>
          </a>
        <% }) } else { %>
          <a class="cat-card" href="/products?category=paper">
            <span class="cat-num">01 / Paper</span>
            <h3>Fine Paper</h3>
            <p>Fountain-pen friendly journals, notepads and bespoke stationery.</p>
            <span class="cat-link">Shop paper →</span>
          </a>
          <a class="cat-card" href="/products?category=pens">
            <span class="cat-num">02 / Pens</span>
            <h3>Writing Tools</h3>
            <p>Precision pens, artisan inks and brass desk accessories.</p>
            <span class="cat-link">Shop pens →</span>
          </a>
          <a class="cat-card" href="/products?category=desk">
            <span class="cat-num">03 / Objects</span>
            <h3>Desk Objects</h3>
            <p>Leather goods, clips and organizational tools for creatives.</p>
            <span class="cat-link">Shop accessories →</span>
          </a>
        <% } %>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="head-row">
        <div class="section-head" style="margin-bottom:0">
          <span class="eyebrow">Staff favorites</span>
          <h2 style="margin:12px 0 0">Recently arrived</h2>
        </div>
        <a class="btn btn-outline" href="/products">View entire catalog</a>
      </div>

      <div class="product-grid">
        <% if (featuredProducts && featuredProducts.length) {
          featuredProducts.forEach((product) => {
            const img = product.images && product.images.length ? product.images[0].url : 'https://images.unsplash.com/photo-1517842645767-c639042777db?auto=format&fit=crop&q=80&w=900';
            const cat = product.category && product.category.name ? product.category.name : product.material;
            const out = product.stock <= 0;
        %>
          <article class="product-card">
            <a class="card-media" href="/products/<%= product.slug %>">
              <img src="<%= img %>" alt="<%= product.name %>" loading="lazy">
              <% if (out) { %><span class="badge badge-stock">Out of stock</span><% } else if (product.featured) { %><span class="badge badge-featured">Featured</span><% } %>
              <span class="quick">View details</span>
            </a>
            <div class="card-body">
              <span class="card-cat"><%= cat %></span>
              <h3><a href="/products/<%= product.slug %>"><%= product.name %></a></h3>
              <p class="card-desc"><%= product.shortDescription || 'A considered everyday essential, made for long writing sessions.' %></p>
              <div class="card-foot">
                <span class="price"><%= helpers.formatMoney(product.price) %><% if (product.compareAtPrice) { %><span class="was"><%= helpers.formatMoney(product.compareAtPrice) %></span><% } %></span>
                <span class="stock-note"><b><%= product.stock %></b> in stock</span>
              </div>
              <div class="card-actions">
                <form action="/cart/items" method="POST" style="margin:0">
                  <input type="hidden" name="productId" value="<%= product.id %>">
                  <input type="hidden" name="quantity" value="1">
                  <button class="btn btn-primary btn-sm btn-block" type="submit" <%= out ? 'disabled' : '' %>>Add to cart</button>
                </form>
                <form action="/wishlist/<%= product.id %>" method="POST" style="margin:0">
                  <button class="btn btn-outline btn-sm" type="submit" aria-label="Save <%= product.name %>">Save</button>
                </form>
              </div>
            </div>
          </article>
        <% }) } else { %>
          <p style="color:var(--mocha);font-style:italic;grid-column:1/-1;text-align:center">Fresh arrivals are on their way — check back soon.</p>
        <% } %>
      </div>
    </div>
  </section>

  <section class="story">
    <div class="container">
      <div>
        <span class="eyebrow">Our story</span>
        <h2>Made for the tactile mind.</h2>
        <p>BoxEseg began with a simple belief — that good tools make better thinking. Every journal is tested for its paper, every pen for its balance. Nothing leaves our desk until it would grace yours.</p>
        <div class="steps">
          <div class="step"><strong>01</strong><span>Curated for quality, not quantity</span></div>
          <div class="step"><strong>02</strong><span>Tested by writers &amp; artists</span></div>
          <div class="step"><strong>03</strong><span>Shipped with obsessive care</span></div>
        </div>
      </div>
      <div class="hero-media">
        <div class="hero-img" style="transform:rotate(-1.5deg)">
          <img src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?auto=format&fit=crop&q=80&w=1000" alt="Open book with a pen and warm paper">
        </div>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <h4>BoxEseg.</h4>
          <p>Curating the finest analog tools for modern writers, thinkers and makers.</p>
        </div>
        <div class="footer-links">
          <h4>Shop</h4>
          <a href="/products">All products</a>
          <a href="/products?sort=price_asc">Under budget</a>
          <a href="/wishlist">Wishlist</a>
        </div>
        <div class="footer-links">
          <h4>Account</h4>
          <a href="/orders">Your orders</a>
          <a href="/profile">Profile</a>
          <a href="mailto:<%= site.email %>"><%= site.email %></a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© <%= new Date().getFullYear() %> BoxEseg. Stationery for the analog mind.</span>
        <span>Designed &amp; printed with care</span>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      const toggle = document.querySelector('[data-toggle]');
      const mobile = document.querySelector('[data-mobile]');
      if (toggle && mobile) {
        toggle.addEventListener('click', () => {
          toggle.classList.toggle('open');
          mobile.classList.toggle('open');
        });
      }
      document.querySelectorAll('[data-dismiss]').forEach((b) => {
        b.addEventListener('click', () => b.closest('.flash').remove());
      });

      const marquee = document.querySelector('[data-marquee]');
      if (marquee && !marquee.dataset.cloned) {
        marquee.innerHTML += marquee.innerHTML;
        marquee.dataset.cloned = 'true';
      }

      const cards = document.querySelectorAll('.product-card');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e, i) => {
            if (e.isIntersecting) {
              setTimeout(() => e.target.classList.add('reveal'), i * 60);
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.1 });
        cards.forEach((c) => io.observe(c));
      } else {
        cards.forEach((c) => c.classList.add('reveal'));
      }
    })();
  </script>
</body>
</html>
