<%
  const count = pagination && pagination.total ? pagination.total : products.length;
  const q = filters.q || '';
  const minPrice = filters.minPrice || '';
  const maxPrice = filters.maxPrice || '';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | BoxEseg</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --latte:#FAF6EF; --latte-2:#F0E9DD; --card:#FFFDF8;
      --espresso:#2B2018; --mocha:#6A5446; --caramel:#C1784F; --caramel-deep:#A25E3C;
      --line:rgba(43,32,24,.12); --line-2:rgba(43,32,24,.26);
      --shadow:0 24px 50px -22px rgba(43,32,24,.22);
      --shadow-sm:0 12px 26px -14px rgba(43,32,24,.18);
      --serif:'Playfair Display',Georgia,serif; --sans:'Inter',-apple-system,'Segoe UI',Arial,sans-serif;
      --r:16px; --r-sm:10px;
    }
    *{margin:0;padding:0;box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{font-family:var(--sans);background:var(--latte);color:var(--espresso);line-height:1.65;-webkit-font-smoothing:antialiased}
    a{text-decoration:none;color:inherit;transition:color .25s ease}
    img{display:block;max-width:100%}
    ul{list-style:none}
    button{font:inherit;cursor:pointer}
    input,select,textarea{font:inherit;color:inherit}
    ::selection{background:var(--caramel);color:#fff}

    .container{width:100%;max-width:1240px;margin:0 auto;padding:0 24px}

    /* ================= Topbar ================= */
    .topbar{position:sticky;top:0;z-index:200;background:rgba(250,246,239,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
    .topbar-inner{display:flex;align-items:center;justify-content:space-between;gap:24px;height:74px}
    .brand{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-size:1.55rem;font-weight:700;letter-spacing:.01em}
    .brand-mark{width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,var(--caramel) 50%,var(--espresso) 50%);box-shadow:0 0 0 2px var(--espresso);transform:rotate(-6deg)}
    .brand span{color:var(--caramel)}
    .site-nav{display:flex;align-items:center;gap:6px}
    .site-nav a{padding:9px 15px;border-radius:999px;font-size:.9rem;font-weight:500;color:var(--mocha)}
    .site-nav a:hover{color:var(--espresso);background:var(--latte-2)}
    .site-nav a.active{background:var(--espresso);color:var(--latte)}
    .nav-actions{display:flex;align-items:center;gap:12px}
    .nav-actions .ghost{font-size:.9rem;font-weight:600;color:var(--espresso)}
    .nav-actions .ghost:hover{color:var(--caramel)}
    .menu-toggle{display:none;flex-direction:column;justify-content:center;gap:5px;width:42px;height:42px;background:transparent;border:1px solid var(--line);border-radius:10px}
    .menu-toggle span{display:block;width:18px;height:2px;background:var(--espresso);margin:0 auto;transition:.3s}
    .menu-toggle.open span:nth-child(1){transform:translateY(3.5px) rotate(45deg)}
    .menu-toggle.open span:nth-child(2){transform:translateY(-3.5px) rotate(-45deg)}

    .mobile-menu{position:fixed;inset:74px 0 auto 0;z-index:190;background:var(--latte);border-bottom:1px solid var(--line);padding:18px 24px 26px;display:none}
    .mobile-menu.open{display:grid;gap:6px}
    .mobile-menu a{padding:13px 10px;border-radius:10px;font-size:1.05rem;font-weight:600}
    .mobile-menu a.active,.mobile-menu a:hover{background:var(--latte-2)}
    .mobile-menu .auth-row{display:flex;gap:10px;margin-top:10px}

    /* ================= Buttons ================= */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 22px;border-radius:999px;border:1px solid var(--espresso);font-size:.9rem;font-weight:600;transition:all .22s ease;background:transparent;color:var(--espresso)}
    .btn-primary{background:var(--espresso);color:var(--latte)}
    .btn-primary:hover{background:var(--caramel);border-color:var(--caramel);transform:translateY(-2px);box-shadow:0 12px 24px -12px rgba(193,120,79,.7)}
    .btn-outline:hover{background:var(--espresso);color:var(--latte);transform:translateY(-2px)}
    .btn-sm{min-height:38px;padding:0 16px;font-size:.83rem}
    .btn-block{width:100%}
    .btn[disabled]{opacity:.45;pointer-events:none}

    /* ================= Flash ================= */
    .flash-stack{position:fixed;top:90px;right:20px;z-index:400;display:grid;gap:10px;width:min(360px,calc(100% - 40px))}
    .flash{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-radius:12px;background:var(--card);border:1px solid var(--line);box-shadow:var(--shadow-sm);animation:slideIn .35s cubic-bezier(.16,1,.3,1)}
    .flash-success{border-left:4px solid #4c9f70}
    .flash-error{border-left:4px solid #c2483e}
    .flash button{border:0;background:transparent;color:var(--mocha);font-size:1rem}
    @keyframes slideIn{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:none}}

    /* ================= Shop hero ================= */
    .shop-hero{padding:64px 0 40px}
    .shop-hero .container{display:flex;flex-direction:column;gap:14px}
    .eyebrow{display:inline-flex;align-items:center;gap:10px;text-transform:uppercase;letter-spacing:.18em;font-size:.74rem;font-weight:600;color:var(--caramel)}
    .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--caramel)}
    .shop-hero h1{font-family:var(--serif);font-size:clamp(2.3rem,4.5vw,3.4rem);font-weight:600;line-height:1.08}
    .shop-hero h1 em{color:var(--caramel)}
    .shop-hero p{color:var(--mocha);max-width:620px}

    /* ================= Filter bar (in nav) ================= */
    .filterbar{position:sticky;top:74px;z-index:150;background:rgba(240,233,221,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
    .filterbar-inner{display:flex;align-items:center;gap:12px;padding:14px 0;flex-wrap:wrap}
    .f-search{flex:1 1 220px;position:relative}
    .f-search input{width:100%;min-height:44px;padding:0 16px 0 40px;border:1px solid var(--line-2);border-radius:999px;background:var(--card);outline:none;font-size:.9rem}
    .f-search svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);width:17px;height:17px;stroke:var(--mocha)}
    .f-search input:focus{border-color:var(--caramel);box-shadow:0 0 0 3px rgba(193,120,79,.15)}
    .f-select{min-height:44px;padding:0 14px;border:1px solid var(--line-2);border-radius:999px;background:var(--card);outline:none;font-size:.86rem;font-weight:500}
    .f-select:focus{border-color:var(--caramel)}
    .f-price{display:flex;align-items:center;gap:6px}
    .f-price input{width:82px;min-height:44px;padding:0 12px;border:1px solid var(--line-2);border-radius:12px;background:var(--card);outline:none;font-size:.86rem}
    .f-price span{color:var(--mocha);font-size:.85rem}
    .filterbar .btn{min-height:42px}
    .filter-reset{display:inline-flex;align-items:center;gap:6px;font-size:.84rem;font-weight:600;color:var(--mocha)}
    .filter-reset:hover{color:var(--caramel-deep)}

    /* ================= Catalog ================= */
    .catalog{padding:44px 0 96px}
    .catalog-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding-bottom:18px;border-bottom:1px solid var(--line)}
    .catalog-head strong{font-family:var(--serif);font-size:1.15rem}
    .catalog-head span{color:var(--mocha);font-size:.9rem}
    .product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:28px;margin-top:26px}
    .active-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
    .chip{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:999px;background:var(--card);border:1px solid var(--line);font-size:.82rem;font-weight:600}
    .chip a{color:var(--caramel-deep);font-weight:700}

    /* ================= Product card ================= */
    .product-card{display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s ease;opacity:0;transform:translateY(24px)}
    .product-card.reveal{opacity:1;transform:translateY(0)}
    .product-card:hover{transform:translateY(-6px);box-shadow:var(--shadow)}
    .card-media{position:relative;display:block;aspect-ratio:4/3.4;overflow:hidden;background:var(--latte-2)}
    .card-media img{width:100%;height:100%;object-fit:cover;transition:transform .5s cubic-bezier(.16,1,.3,1)}
    .product-card:hover .card-media img{transform:scale(1.06)}
    .card-media::after{content:"";position:absolute;inset:auto 0 0 0;height:42%;background:linear-gradient(to top,rgba(43,32,24,.45),transparent);opacity:0;transition:opacity .3s}
    .product-card:hover .card-media::after{opacity:1}
    .card-media .quick{position:absolute;right:14px;bottom:14px;z-index:2;padding:8px 14px;border-radius:999px;background:var(--card);font-size:.76rem;font-weight:700;letter-spacing:.04em;opacity:0;transform:translateY(8px);transition:.3s}
    .product-card:hover .quick{opacity:1;transform:none}
    .badge{position:absolute;top:14px;left:14px;z-index:2;padding:6px 12px;border-radius:999px;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}
    .badge-featured{background:var(--espresso);color:var(--latte)}
    .badge-stock{background:#e8ded1;color:var(--mocha)}
    .card-body{display:flex;flex-direction:column;gap:10px;padding:20px 20px 22px;flex:1}
    .card-cat{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.14em;color:var(--caramel)}
    .card-body h3{font-family:var(--serif);font-size:1.32rem;font-weight:600;line-height:1.2}
    .card-body h3 a:hover{color:var(--caramel-deep)}
    .card-desc{color:var(--mocha);font-size:.9rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .card-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto;padding-top:14px;border-top:1px dashed var(--line-2)}
    .price{font-family:var(--serif);font-size:1.28rem;font-weight:700}
    .price .was{font-family:var(--sans);font-size:.85rem;font-weight:400;color:var(--mocha);text-decoration:line-through;margin-left:8px}
    .stock-note{font-size:.78rem;color:var(--mocha)}
    .stock-note b{color:var(--espresso)}
    .card-actions{display:grid;grid-template-columns:1fr auto;gap:10px;margin-top:4px}

    /* ================= Pagination ================= */
    .pagination{display:flex;justify-content:center;align-items:center;gap:12px;margin-top:52px}
    .pagination a,.pagination span{min-width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;padding:0 16px;border:1px solid var(--line-2);border-radius:12px;font-weight:600;font-size:.9rem;background:var(--card)}
    .pagination a:hover{background:var(--espresso);color:var(--latte);border-color:var(--espresso)}
    .pagination .current{background:var(--espresso);color:var(--latte);border-color:var(--espresso)}
    .pagination .label{background:transparent;border-color:transparent;color:var(--mocha)}

    .empty-state{padding:70px 30px;text-align:center;background:var(--card);border:1px dashed var(--line-2);border-radius:var(--r)}
    .empty-state h2{font-family:var(--serif);font-size:1.7rem;margin-bottom:8px}
    .empty-state p{color:var(--mocha);margin-bottom:22px}

    /* ================= Footer ================= */
    .site-footer{background:var(--espresso);color:var(--latte);margin-top:20px}
    .footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:48px;padding:72px 0 48px}
    .footer-grid h4{font-family:var(--serif);font-size:1.05rem;margin-bottom:16px;color:var(--latte)}
    .footer-brand p{color:rgba(250,246,239,.62);max-width:300px;margin-top:12px}
    .footer-links{display:flex;flex-direction:column;gap:11px}
    .footer-links a{color:rgba(250,246,239,.62)}
    .footer-links a:hover{color:var(--latte)}
    .footer-bottom{border-top:1px solid rgba(250,246,239,.14);padding:22px 0;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:rgba(250,246,239,.5);font-size:.85rem}

    /* ================= Responsive ================= */
    @media(max-width:900px){
      .site-nav,.nav-actions .hide-m{display:none}
      .menu-toggle{display:flex}
      .nav-actions{display:none}
      .filterbar{position:static}
      .footer-grid{grid-template-columns:1fr;gap:32px;padding-block:52px}
    }
    @media(max-width:560px){
      .topbar-inner{height:66px}
      .mobile-menu{inset:66px 0 auto 0}
      .f-search{flex-basis:100%}
      .filterbar-inner{flex-wrap:wrap}
      .product-grid{grid-template-columns:1fr;gap:20px}
      .shop-hero{padding:40px 0 28px}
      .catalog{padding:28px 0 70px}
    }
  </style>
</head>
<body>

  <header class="topbar">
    <div class="container topbar-inner">
      <a href="/" class="brand"><span class="brand-mark"></span>Box<span>Eseg</span></a>

      <button class="menu-toggle" data-toggle aria-label="Toggle navigation">
        <span></span><span></span>
      </button>

      <nav class="site-nav">
        <a href="/">Home</a>
        <a href="/products" class="active">Shop</a>
        <a href="/wishlist">Wishlist</a>
        <a href="/cart">Cart</a>
        <% if (currentUser && currentUser.role === 'admin') { %>
          <a href="/dashboard">Dashboard</a>
        <% } %>
      </nav>

      <div class="nav-actions">
        <% if (currentUser) { %>
          <a class="ghost" href="/profile"><%= currentUser.firstName %></a>
          <form action="/auth/logout" method="POST" style="margin:0">
            <button class="btn btn-sm btn-outline" type="submit">Logout</button>
          </form>
        <% } else { %>
          <a class="ghost hide-m" href="/auth/login">Login</a>
          <a class="btn btn-sm btn-primary" href="/auth/register">Get started</a>
        <% } %>
      </div>
    </div>
  </header>

  <div class="mobile-menu" data-mobile>
    <a href="/">Home</a>
    <a href="/products" class="active">Shop</a>
    <a href="/wishlist">Wishlist</a>
    <a href="/cart">Cart</a>
    <% if (currentUser && currentUser.role === 'admin') { %>
      <a href="/dashboard">Dashboard</a>
    <% } %>
    <div class="auth-row">
      <% if (currentUser) { %>
        <a class="btn btn-sm btn-primary" href="/profile"><%= currentUser.firstName %></a>
        <a class="btn btn-sm btn-outline" href="/auth/logout">Logout</a>
      <% } else { %>
        <a class="btn btn-sm btn-outline" href="/auth/login">Login</a>
        <a class="btn btn-sm btn-primary" href="/auth/register">Get started</a>
      <% } %>
    </div>
  </div>

  <% if (flash && flash.length) { %>
    <div class="flash-stack">
      <% flash.forEach((item) => { %>
        <div class="flash flash-<%= item.type %>">
          <span><%= item.message %></span>
          <button type="button" data-dismiss aria-label="Dismiss">×</button>
        </div>
      <% }) %>
    </div>
  <% } %>

  <main>
    <section class="shop-hero">
      <div class="container">
        <span class="eyebrow">The Collection</span>
        <h1>Stationery crafted to be <em>kept.</em></h1>
        <p>Journals, pens, inks and desk objects — every piece selected for the desk you spend your life at.</p>
      </div>
    </section>

    <div class="filterbar">
      <form class="container filterbar-inner" action="/products" method="GET" data-filter-form>
        <div class="f-search">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" name="q" value="<%= q %>" placeholder="Search journals, pens, inks..." aria-label="Search products">
        </div>

        <select class="f-select" name="category" data-auto-submit>
          <option value="">All categories</option>
          <% categories.forEach((category) => { %>
            <option value="<%= category.slug %>" <%= filters.category === category.slug ? 'selected' : '' %>><%= category.name %></option>
          <% }) %>
        </select>

        <select class="f-select" name="material" data-auto-submit>
          <option value="">All materials</option>
          <% Object.entries(materialLabels).forEach(([value, label]) => { %>
            <option value="<%= value %>" <%= filters.material === value ? 'selected' : '' %>><%= label %></option>
          <% }) %>
        </select>

        <select class="f-select" name="sort" data-auto-submit>
          <option value="latest" <%= filters.sort === 'latest' ? 'selected' : '' %>>Newest</option>
          <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price low → high</option>
          <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price high → low</option>
          <option value="rating" <%= filters.sort === 'rating' ? 'selected' : '' %>>Best rated</option>
        </select>

        <div class="f-price">
          <input type="number" name="minPrice" min="0" placeholder="Min" value="<%= minPrice %>" aria-label="Min price">
          <span>—</span>
          <input type="number" name="maxPrice" min="0" placeholder="Max" value="<%= maxPrice %>" aria-label="Max price">
        </div>

        <button class="btn btn-primary btn-sm" type="submit">Apply</button>
        <a class="filter-reset" href="/products">Reset</a>
      </form>
    </div>

    <section class="catalog">
      <div class="container">
        <div class="catalog-head">
          <strong><%= count %> <%= count === 1 ? 'product' : 'products' %></strong>
          <span>Hand-picked for your desk</span>
        </div>

        <% if (filters.category || filters.material || filters.q || filters.minPrice || filters.maxPrice) { %>
          <div class="active-chips">
            <% if (filters.q) { %><span class="chip">“<%= filters.q %>” <a href="<%= helpers.queryString(filters, { q: '' }) %>">×</a></span><% } %>
            <% if (filters.category) { %><span class="chip">Category: <%= filters.category %> <a href="<%= helpers.queryString(filters, { category: '' }) %>">×</a></span><% } %>
            <% if (filters.material) { %><span class="chip">Material: <%= materialLabels[filters.material] || filters.material %> <a href="<%= helpers.queryString(filters, { material: '' }) %>">×</a></span><% } %>
            <% if (filters.minPrice || filters.maxPrice) { %><span class="chip">Price range <a href="<%= helpers.queryString(filters, { minPrice: '', maxPrice: '' }) %>">×</a></span><% } %>
          </div>
        <% } %>

        <% if (products.length) { %>
          <div class="product-grid">
            <% products.forEach((product, index) => {
              const img = product.images && product.images.length ? product.images[0].url : 'https://images.unsplash.com/photo-1517842645767-c639042777db?auto=format&fit=crop&q=80&w=900';
              const cat = product.category && product.category.name ? product.category.name : product.material;
              const out = product.stock <= 0;
            %>
              <article class="product-card">
                <a class="card-media" href="/products/<%= product.slug %>" aria-label="<%= product.name %>">
                  <img src="<%= img %>" alt="<%= product.name %>" loading="lazy">
                  <% if (out) { %>
                    <span class="badge badge-stock">Out of stock</span>
                  <% } else if (product.featured) { %>
                    <span class="badge badge-featured">Featured</span>
                  <% } %>
                  <span class="quick">View details</span>
                </a>
                <div class="card-body">
                  <span class="card-cat"><%= cat %></span>
                  <h3><a href="/products/<%= product.slug %>"><%= product.name %></a></h3>
                  <p class="card-desc"><%= product.shortDescription || 'A considered everyday essential, made for long writing sessions.' %></p>
                  <div class="card-foot">
                    <span class="price">
                      <%= helpers.formatMoney(product.price) %>
                      <% if (product.compareAtPrice) { %><span class="was"><%= helpers.formatMoney(product.compareAtPrice) %></span><% } %>
                    </span>
                    <span class="stock-note"><b><%= product.stock %></b> in stock</span>
                  </div>
                  <div class="card-actions">
                    <form action="/cart/items" method="POST" style="margin:0">
                      <input type="hidden" name="productId" value="<%= product.id %>">
                      <input type="hidden" name="quantity" value="1">
                      <button class="btn btn-primary btn-sm btn-block" type="submit" <%= out ? 'disabled' : '' %>>Add to cart</button>
                    </form>
                    <form action="/wishlist/<%= product.id %>" method="POST" style="margin:0">
                      <button class="btn btn-outline btn-sm" type="submit" aria-label="Save <%= product.name %>">Save</button>
                    </form>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>

          <% if (pagination && pagination.totalPages > 1) { %>
            <nav class="pagination" aria-label="Pagination">
              <% if (pagination.hasPrev) { %>
                <a href="<%= helpers.queryString(query, { page: pagination.prevPage }) %>">← Prev</a>
              <% } else { %>
                <span class="label">← Prev</span>
              <% } %>
              <span class="current"><%= pagination.page %></span>
              <span class="label">of <%= pagination.totalPages %></span>
              <% if (pagination.hasNext) { %>
                <a href="<%= helpers.queryString(query, { page: pagination.nextPage }) %>">Next →</a>
              <% } else { %>
                <span class="label">Next →</span>
              <% } %>
            </nav>
          <% } %>

        <% } else { %>
          <div class="empty-state">
            <h2>No products found</h2>
            <p>Try a wider search or clear a filter — the right tool is here somewhere.</p>
            <a class="btn btn-primary" href="/products">Clear filters</a>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <h4>BoxEseg.</h4>
          <p>Curating the finest analog tools for modern writers, thinkers and makers.</p>
        </div>
        <div class="footer-links">
          <h4>Shop</h4>
          <a href="/products">All products</a>
          <a href="/products?sort=price_asc">Under budget</a>
          <a href="/wishlist">Wishlist</a>
        </div>
        <div class="footer-links">
          <h4>Account</h4>
          <a href="/orders">Your orders</a>
          <a href="/profile">Profile</a>
          <a href="mailto:<%= site.email %>"><%= site.email %></a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© <%= new Date().getFullYear() %> BoxEseg. Stationery for the analog mind.</span>
        <span>Designed & printed with care</span>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      const toggle = document.querySelector('[data-toggle]');
      const mobile = document.querySelector('[data-mobile]');
      if (toggle && mobile) {
        toggle.addEventListener('click', () => {
          toggle.classList.toggle('open');
          mobile.classList.toggle('open');
        });
      }

      document.querySelectorAll('[data-dismiss]').forEach((b) => {
        b.addEventListener('click', () => b.closest('.flash').remove());
      });

      document.querySelectorAll('[data-auto-submit]').forEach((select) => {
        select.addEventListener('change', () => {
          select.form.submit();
        });
      });

      const cards = document.querySelectorAll('.product-card');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e, i) => {
            if (e.isIntersecting) {
              setTimeout(() => e.target.classList.add('reveal'), i * 60);
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.1 });
        cards.forEach((c) => io.observe(c));
      } else {
        cards.forEach((c) => c.classList.add('reveal'));
      }
    })();
  </script>
</body>
</html>
