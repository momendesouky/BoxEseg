<%
  const primaryImage = product.images && product.images.length ? product.images[0].url : 'https://images.unsplash.com/photo-1517842645767-c639042777db?auto=format&fit=crop&q=80&w=1000';
  const out = product.stock <= 0;
  const dims = product.dimensions || {};
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <title><%= product.name %> | BoxEseg</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --latte:#FAF6EF; --latte-2:#F0E9DD; --card:#FFFDF8;
      --espresso:#2B2018; --mocha:#6A5446; --caramel:#C1784F; --caramel-deep:#A25E3C;
      --line:rgba(43,32,24,.12); --line-2:rgba(43,32,24,.26);
      --shadow:0 24px 50px -22px rgba(43,32,24,.22);
      --shadow-sm:0 12px 26px -14px rgba(43,32,24,.18);
      --serif:'Playfair Display',Georgia,serif; --sans:'Inter',-apple-system,'Segoe UI',Arial,sans-serif;
      --r:16px; --r-sm:10px;
    }
    *{margin:0;padding:0;box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{font-family:var(--sans);background:var(--latte);color:var(--espresso);line-height:1.65;-webkit-font-smoothing:antialiased}
    a{text-decoration:none;color:inherit;transition:color .25s ease}
    img{display:block;max-width:100%}
    ul{list-style:none}
    button{font:inherit;cursor:pointer}
    input,select,textarea{font:inherit;color:inherit}
    ::selection{background:var(--caramel);color:#fff}
    .container{width:100%;max-width:1240px;margin:0 auto;padding:0 24px}

    /* ================= Topbar ================= */
    .topbar{position:sticky;top:0;z-index:200;background:rgba(250,246,239,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
    .topbar-inner{display:flex;align-items:center;justify-content:space-between;gap:24px;height:74px}
    .brand{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-size:1.55rem;font-weight:700}
    .brand-mark{width:38px;height:38px;background:url('/images/logo.png') no-repeat center/contain}
    .brand span{color:var(--caramel)}
    .site-nav{display:flex;align-items:center;gap:6px}
    .site-nav a{padding:9px 15px;border-radius:999px;font-size:.9rem;font-weight:500;color:var(--mocha)}
    .site-nav a:hover{color:var(--espresso);background:var(--latte-2)}
    .site-nav a.active{background:var(--espresso);color:var(--latte)}
    .nav-actions{display:flex;align-items:center;gap:12px}
    .nav-actions .ghost{font-size:.9rem;font-weight:600}
    .nav-actions .ghost:hover{color:var(--caramel)}
    .menu-toggle{display:none;flex-direction:column;justify-content:center;gap:5px;width:42px;height:42px;background:transparent;border:1px solid var(--line);border-radius:10px}
    .menu-toggle span{display:block;width:18px;height:2px;background:var(--espresso);margin:0 auto;transition:.3s}
    .menu-toggle.open span:nth-child(1){transform:translateY(3.5px) rotate(45deg)}
    .menu-toggle.open span:nth-child(2){transform:translateY(-3.5px) rotate(-45deg)}
    .mobile-menu{position:fixed;inset:74px 0 auto 0;z-index:190;background:var(--latte);border-bottom:1px solid var(--line);padding:18px 24px 26px;display:none}
    .mobile-menu.open{display:grid;gap:6px}
    .mobile-menu a{padding:13px 10px;border-radius:10px;font-size:1.05rem;font-weight:600}
    .mobile-menu a:hover{background:var(--latte-2)}
    .mobile-menu .auth-row{display:flex;gap:10px;margin-top:10px}

    /* ================= Buttons / forms ================= */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 22px;border-radius:999px;border:1px solid var(--espresso);font-size:.9rem;font-weight:600;transition:all .22s ease;background:transparent;color:var(--espresso)}
    .btn-primary{background:var(--espresso);color:var(--latte)}
    .btn-primary:hover{background:var(--caramel);border-color:var(--caramel);transform:translateY(-2px);box-shadow:0 12px 24px -12px rgba(193,120,79,.7)}
    .btn-outline:hover{background:var(--espresso);color:var(--latte);transform:translateY(-2px)}
    .btn-sm{min-height:38px;padding:0 16px;font-size:.83rem}
    .btn[disabled]{opacity:.45;pointer-events:none}
    label{display:grid;gap:7px;font-size:.85rem;font-weight:600}
    input,select,textarea{width:100%;min-height:48px;border:1px solid var(--line-2);border-radius:12px;background:var(--card);padding:10px 14px;outline:none;transition:border-color .2s,box-shadow .2s}
    input:focus,select:focus,textarea:focus{border-color:var(--caramel);box-shadow:0 0 0 3px rgba(193,120,79,.15)}

    /* ================= Flash ================= */
    .flash-stack{position:fixed;top:90px;right:20px;z-index:400;display:grid;gap:10px;width:min(360px,calc(100% - 40px))}
    .flash{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-radius:12px;background:var(--card);border:1px solid var(--line);box-shadow:var(--shadow-sm);animation:slideIn .35s cubic-bezier(.16,1,.3,1)}
    .flash-success{border-left:4px solid #4c9f70}
    .flash-error{border-left:4px solid #c2483e}
    .flash button{border:0;background:transparent;color:var(--mocha);font-size:1rem}
    @keyframes slideIn{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:none}}

    /* ================= Detail ================= */
    .detail{padding:52px 0 30px}
    .crumbs{display:flex;gap:8px;align-items:center;font-size:.85rem;color:var(--mocha);margin-bottom:34px;flex-wrap:wrap}
    .crumbs a:hover{color:var(--caramel-deep)}
    .crumbs .sep{opacity:.5}
    .detail-grid{display:grid;grid-template-columns:minmax(0,.95fr) minmax(360px,.8fr);gap:56px;align-items:start}
    .gallery{border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow);position:relative;aspect-ratio:1/1;background:var(--latte-2)}
    .gallery img{width:100%;height:100%;object-fit:cover}
    .gallery .badge{position:absolute;top:18px;left:18px;z-index:2;padding:7px 14px;border-radius:999px;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}
    .badge-featured{background:var(--espresso);color:var(--latte)}
    .badge-stock{background:#e8ded1;color:var(--mocha)}
    .eyebrow{display:inline-flex;align-items:center;gap:10px;text-transform:uppercase;letter-spacing:.18em;font-size:.74rem;font-weight:600;color:var(--caramel)}
    .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--caramel)}
    .info h1{font-family:var(--serif);font-size:clamp(2rem,3.6vw,2.9rem);font-weight:600;line-height:1.1;margin:14px 0 12px}
    .lead{color:var(--mocha);font-size:1.05rem}
    .price-row{display:flex;align-items:baseline;gap:14px;margin:22px 0}
    .price-row .now{font-family:var(--serif);font-size:2rem;font-weight:700}
    .price-row .was{color:var(--mocha);text-decoration:line-through;font-size:1.05rem}
    .price-row .save{padding:4px 12px;border-radius:999px;background:#e7f0e9;color:#2f7d50;font-size:.78rem;font-weight:700}
    .stock-banner{display:inline-flex;align-items:center;gap:8px;padding:9px 16px;border-radius:999px;font-size:.84rem;font-weight:600;margin-bottom:20px}
    .stock-in{background:#e7f0e9;color:#2f7d50}
    .stock-out{background:#f5e7e4;color:#b04035}
    .stock-banner i{width:8px;height:8px;border-radius:50%;background:currentColor}
    .specs{display:grid;grid-template-columns:1fr 1fr;gap:0;margin:26px 0;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--card)}
    .specs div{padding:13px 16px;border-bottom:1px dashed var(--line);font-size:.88rem}
    .specs div:nth-child(odd){border-right:1px solid var(--line)}
    .specs div:nth-last-child(-n+2){border-bottom:0}
    .specs dt{color:var(--mocha);font-size:.76rem;text-transform:uppercase;letter-spacing:.1em}
    .specs dd{font-weight:700;margin-top:2px}
    .buy-form{display:grid;gap:16px;margin-top:6px}
    .buy-form .qty-row{display:flex;gap:12px;align-items:end}
    .qty-row label{flex:1}
    .buy-actions{display:grid;grid-template-columns:1fr auto;gap:12px}
    .buy-form textarea{min-height:84px;resize:vertical}

    /* ================= Description & reviews ================= */
    .story-sec{border-top:1px dashed var(--line-2);padding:64px 0}
    .story-sec .container{display:grid;grid-template-columns:.4fr .6fr;gap:48px}
    .story-sec h2{font-family:var(--serif);font-size:2rem;font-weight:600;margin:12px 0}
    .story-sec p{color:var(--mocha)}
    .reviews-sec{border-top:1px dashed var(--line-2);padding:64px 0 96px}
    .reviews-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:32px;flex-wrap:wrap}
    .reviews-head h2{font-family:var(--serif);font-size:2rem;font-weight:600;margin:12px 0 0}
    .review-layout{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:28px;align-items:start}
    .review-list{display:grid;gap:16px}
    .review-item{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:22px;opacity:0;transform:translateY(18px)}
    .review-item.reveal{opacity:1;transform:none;transition:.5s cubic-bezier(.16,1,.3,1)}
    .review-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px}
    .review-top .stars{color:var(--caramel);letter-spacing:2px}
    .review-item h3{font-family:var(--serif);font-size:1.15rem;margin-bottom:6px}
    .review-item p{color:var(--mocha);font-size:.95rem}
    .review-item .author{margin-top:10px;font-size:.8rem;color:var(--mocha)}
    .review-form{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:24px}
    .review-form h3{font-family:var(--serif);font-size:1.25rem;margin-bottom:16px}
    .review-form form{display:grid;gap:14px}
    .empty-note{color:var(--mocha);font-style:italic}

    /* ================= Footer ================= */
    .site-footer{background:var(--espresso);color:var(--latte);margin-top:20px}
    .footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:48px;padding:72px 0 48px}
    .footer-grid h4{font-family:var(--serif);font-size:1.05rem;margin-bottom:16px}
    .footer-brand p{color:rgba(250,246,239,.62);max-width:300px;margin-top:12px}
    .footer-links{display:flex;flex-direction:column;gap:11px}
    .footer-links a{color:rgba(250,246,239,.62)}
    .footer-links a:hover{color:var(--latte)}
    .footer-bottom{border-top:1px solid rgba(250,246,239,.14);padding:22px 0;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:rgba(250,246,239,.5);font-size:.85rem}

    /* ================= Responsive ================= */
    @media(max-width:960px){
      .site-nav{display:none}
      .menu-toggle{display:flex}
      .nav-actions{display:none}
      .detail-grid{grid-template-columns:1fr;gap:36px}
      .gallery{aspect-ratio:4/3.4}
      .review-layout{grid-template-columns:1fr}
      .story-sec .container{grid-template-columns:1fr;gap:20px}
      .footer-grid{grid-template-columns:1fr;gap:32px;padding-block:52px}
    }
    @media(max-width:600px){
      .topbar-inner{height:66px}
      .mobile-menu{inset:66px 0 auto 0}
      .specs{grid-template-columns:1fr}
      .specs div:nth-child(odd){border-right:0}
      .specs div:nth-last-child(-n+2){border-bottom:1px dashed var(--line)}
      .specs div:last-child{border-bottom:0}
      .buy-actions{grid-template-columns:1fr}
      .buy-form .qty-row{flex-direction:column;align-items:stretch}
      .reviews-sec,.story-sec{padding:52px 0}
    }
  </style>
</head>
<body>

  <header class="topbar">
    <div class="container topbar-inner">
      <a href="/" class="brand"><span class="brand-mark"></span>Box<span>Eseg</span></a>
      <button class="menu-toggle" data-toggle aria-label="Toggle navigation"><span></span><span></span></button>
      <nav class="site-nav">
        <a href="/">Home</a>
        <a href="/products" class="active">Shop</a>
        <a href="/wishlist">Wishlist</a>
        <a href="/cart">Cart</a>
        <% if (currentUser && currentUser.role === 'admin') { %><a href="/dashboard">Dashboard</a><% } %>
      </nav>
      <div class="nav-actions">
        <% if (currentUser) { %>
          <a class="ghost" href="/profile"><%= currentUser.firstName %></a>
          <form action="/auth/logout" method="POST" style="margin:0"><button class="btn btn-sm btn-outline" type="submit">Logout</button></form>
        <% } else { %>
          <a class="ghost" href="/auth/login">Login</a>
          <a class="btn btn-sm btn-primary" href="/auth/register">Get started</a>
        <% } %>
      </div>
    </div>
  </header>

  <div class="mobile-menu" data-mobile>
    <a href="/">Home</a>
    <a href="/products" class="active">Shop</a>
    <a href="/wishlist">Wishlist</a>
    <a href="/cart">Cart</a>
    <% if (currentUser && currentUser.role === 'admin') { %><a href="/dashboard">Dashboard</a><% } %>
    <div class="auth-row">
      <% if (currentUser) { %>
        <a class="btn btn-sm btn-primary" href="/profile"><%= currentUser.firstName %></a>
        <a class="btn btn-sm btn-outline" href="/auth/logout">Logout</a>
      <% } else { %>
        <a class="btn btn-sm btn-outline" href="/auth/login">Login</a>
        <a class="btn btn-sm btn-primary" href="/auth/register">Get started</a>
      <% } %>
    </div>
  </div>

  <% if (flash && flash.length) { %>
    <div class="flash-stack">
      <% flash.forEach((item) => { %>
        <div class="flash flash-<%= item.type %>"><span><%= item.message %></span><button type="button" data-dismiss aria-label="Dismiss">×</button></div>
      <% }) %>
    </div>
  <% } %>

  <main>
    <section class="detail">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/products">Shop</a>
          <span class="sep">/</span>
          <span><%= product.category ? product.category.name : product.material %></span>
          <span class="sep">/</span>
          <span style="color:var(--espresso);font-weight:600"><%= product.name %></span>
        </nav>

        <div class="detail-grid">
          <div class="gallery">
            <img src="<%= primaryImage %>" alt="<%= product.name %>">
            <% if (out) { %><span class="badge badge-stock">Out of stock</span><% } else if (product.featured) { %><span class="badge badge-featured">Featured</span><% } %>
          </div>

          <div class="info">
            <span class="eyebrow"><%= product.material %><% if (product.category) { %> / <%= product.category.name %><% } %></span>
            <h1><%= product.name %></h1>
            <p class="lead"><%= product.shortDescription || product.description %></p>

            <div class="price-row">
              <span class="now"><%= helpers.formatMoney(product.price) %></span>
              <% if (product.compareAtPrice) { %>
                <span class="was"><%= helpers.formatMoney(product.compareAtPrice) %></span>
                <% if (product.compareAtPrice > product.price) { %><span class="save">Save <%= helpers.formatMoney(product.compareAtPrice - product.price) %></span><% } %>
              <% } %>
            </div>

            <% if (out) { %>
              <span class="stock-banner stock-out"><i></i> Currently out of stock</span>
            <% } else if (product.stock < 10) { %>
              <span class="stock-banner stock-in"><i></i> Only <%= product.stock %> left in stock</span>
            <% } else { %>
              <span class="stock-banner stock-in"><i></i> In stock — <%= product.stock %> available</span>
            <% } %>

            <div class="specs">
              <div><dt>SKU</dt><dd><%= product.sku %></dd></div>
              <div><dt>Stock</dt><dd><%= product.stock %></dd></div>
              <% if (dims.thickness) { %><div><dt>Thickness</dt><dd><%= dims.thickness %> <%= dims.unit || 'mm' %></dd></div><% } %>
              <% if (dims.length) { %><div><dt>Size</dt><dd><%= dims.length %> × <%= dims.width || '—' %> <%= dims.unit || 'mm' %></dd></div><% } %>
            </div>

            <form class="buy-form" action="/cart/items" method="POST">
              <input type="hidden" name="productId" value="<%= product.id %>">
              <div class="qty-row">
                <label>Quantity
                  <input type="number" name="quantity" min="1" max="<%= product.stock %>" value="1">
                </label>
              </div>
              <label>Personal note
                <textarea name="cutNotes" rows="3" placeholder="Gift message, engraving or packing notes..."></textarea>
              </label>
              <div class="buy-actions">
                <button class="btn btn-primary" type="submit" <%= out ? 'disabled' : '' %>>Add to cart</button>
                <button class="btn btn-outline" type="submit" formaction="/wishlist/<%= product.id %>" formmethod="POST">Save for later</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section class="story-sec">
      <div class="container">
        <div>
          <span class="eyebrow">Details</span>
          <h2>Material notes</h2>
        </div>
        <p><%= product.description || 'Chosen for dependable quality, careful finishing and everyday performance — a piece that earns its place on your desk.' %></p>
      </div>
    </section>

    <section class="reviews-sec">
      <div class="container">
        <div class="reviews-head">
          <div>
            <span class="eyebrow">Reviews</span>
            <h2>Customer feedback</h2>
          </div>
          <span class="empty-note"><%= reviews.length %> <%= reviews.length === 1 ? 'review' : 'reviews' %></span>
        </div>

        <div class="review-layout">
          <div class="review-list">
            <% if (reviews.length) {
              reviews.forEach((review) => {
                let stars = '';
                for (let s = 0; s < review.rating; s++) { stars += '★'; }
                for (let s = review.rating; s < 5; s++) { stars += '☆'; }
            %>
              <article class="review-item">
                <div class="review-top">
                  <span class="stars"><%= stars %></span>
                  <span class="author"><%= review.user ? review.user.firstName + ' ' + (review.user.lastName || '') : 'Customer' %></span>
                </div>
                <h3><%= review.title || 'Product review' %></h3>
                <p><%= review.comment %></p>
              </article>
            <% }) } else { %>
              <p class="empty-note">No reviews yet — be the first to share your thoughts after signing in.</p>
            <% } %>
          </div>

          <% if (currentUser) { %>
            <div class="review-form">
              <h3>Write a review</h3>
              <form action="/products/<%= product.id %>/reviews" method="POST">
                <label>Rating
                  <select name="rating" required>
                    <option value="5">★★★★★ Excellent</option>
                    <option value="4">★★★★ Good</option>
                    <option value="3">★★★ Average</option>
                    <option value="2">★★ Poor</option>
                    <option value="1">★ Bad</option>
                  </select>
                </label>
                <label>Title<input type="text" name="title" placeholder="A short headline"></label>
                <label>Comment<textarea name="comment" rows="4" placeholder="What did you think?"></textarea></label>
                <button class="btn btn-primary" type="submit">Submit review</button>
              </form>
            </div>
          <% } else { %>
            <div class="review-form">
              <h3>Leave a review</h3>
              <p class="empty-note" style="margin:10px 0 18px">Sign in to share your experience with this piece.</p>
              <a class="btn btn-outline" href="/auth/login">Sign in to review</a>
            </div>
          <% } %>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <h4>BoxEseg.</h4>
          <p>Curating the finest analog tools for modern writers, thinkers and makers.</p>
        </div>
        <div class="footer-links">
          <h4>Shop</h4>
          <a href="/products">All products</a>
          <a href="/products?sort=price_asc">Under budget</a>
          <a href="/wishlist">Wishlist</a>
        </div>
        <div class="footer-links">
          <h4>Account</h4>
          <a href="/orders">Your orders</a>
          <a href="/profile">Profile</a>
          <a href="mailto:<%= site.email %>"><%= site.email %></a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© <%= new Date().getFullYear() %> BoxEseg. Stationery for the analog mind.</span>
        <span>Designed &amp; printed with care</span>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      const toggle = document.querySelector('[data-toggle]');
      const mobile = document.querySelector('[data-mobile]');
      if (toggle && mobile) {
        toggle.addEventListener('click', () => {
          toggle.classList.toggle('open');
          mobile.classList.toggle('open');
        });
      }
      document.querySelectorAll('[data-dismiss]').forEach((b) => {
        b.addEventListener('click', () => b.closest('.flash').remove());
      });
      const items = document.querySelectorAll('.review-item');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e, i) => {
            if (e.isIntersecting) {
              setTimeout(() => e.target.classList.add('reveal'), i * 80);
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.15 });
        items.forEach((c) => io.observe(c));
      } else {
        items.forEach((c) => c.classList.add('reveal'));
      }
    })();
  </script>
</body>
</html>
