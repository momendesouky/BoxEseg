<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <title>Mobile Wallet Payment | BoxEseg</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --latte:#FAF6EF; --latte-2:#F0E9DD; --card:#FFFDF8;
      --espresso:#2B2018; --mocha:#6A5446; --caramel:#C1784F; --caramel-deep:#A25E3C;
      --line:rgba(43,32,24,.12); --line-2:rgba(43,32,24,.26);
      --shadow:0 24px 50px -22px rgba(43,32,24,.22);
      --shadow-sm:0 12px 26px -14px rgba(43,32,24,.18);
      --serif:'Playfair Display',Georgia,serif; --sans:'Inter',-apple-system,'Segoe UI',Arial,sans-serif;
      --r:16px; --r-sm:10px;
    }
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:var(--sans);background:var(--latte);color:var(--espresso);line-height:1.65;-webkit-font-smoothing:antialiased;min-height:100vh;display:flex;flex-direction:column}
    a{text-decoration:none;color:inherit}
    button{font:inherit;cursor:pointer}
    input{font:inherit;color:inherit}
    ::selection{background:var(--caramel);color:#fff}
    .container{width:100%;max-width:1240px;margin:0 auto;padding:0 24px}

    .topbar{position:sticky;top:0;z-index:200;background:rgba(250,246,239,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
    .topbar-inner{display:flex;align-items:center;justify-content:space-between;gap:24px;height:74px}
    .brand{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-size:1.55rem;font-weight:700}
    .brand-mark{width:38px;height:38px;background:url('/images/logo.png') no-repeat center/contain}
    .brand span{color:var(--caramel)}
    .nav-actions{display:flex;align-items:center;gap:12px}
    .ghost{font-size:.9rem;font-weight:600}
    .ghost:hover{color:var(--caramel)}

    .flash-stack{position:fixed;top:90px;right:20px;z-index:400;display:grid;gap:10px;width:min(360px,calc(100% - 40px))}
    .flash{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-radius:12px;background:var(--card);border:1px solid var(--line);box-shadow:var(--shadow-sm);animation:slideIn .35s cubic-bezier(.16,1,.3,1)}
    .flash-success{border-left:4px solid #4c9f70}
    .flash-error{border-left:4px solid #c2483e}
    .flash-warning{border-left:4px solid #d4a017}
    .flash-info{border-left:4px solid #5a8ec2}
    .flash button{border:0;background:transparent;color:var(--mocha);font-size:1rem}
    @keyframes slideIn{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:none}}

    .page{padding:56px 0 96px;flex:1}
    .eyebrow{display:inline-flex;align-items:center;gap:10px;text-transform:uppercase;letter-spacing:.18em;font-size:.74rem;font-weight:600;color:var(--caramel)}
    .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--caramel)}
    .page-head{margin-bottom:40px}
    .page-head h1{font-family:var(--serif);font-size:clamp(2.1rem,4vw,3rem);font-weight:600;margin-top:14px}

    .wallet-card{max-width:480px;margin:0 auto;background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:36px;box-shadow:var(--shadow)}
    .wallet-card h2{font-family:var(--serif);font-size:1.4rem;margin-bottom:6px}
    .wallet-card p{color:var(--mocha);font-size:.9rem;margin-bottom:24px}
    .wallet-card label{display:grid;gap:7px;font-size:.85rem;font-weight:600;margin-bottom:18px}
    .wallet-card input[type="tel"]{width:100%;min-height:52px;border:1px solid var(--line-2);border-radius:12px;background:var(--latte);padding:12px 16px;outline:none;transition:border-color .2s,box-shadow .2s;font-size:1.05rem;letter-spacing:.04em}
    .wallet-card input[type="tel"]:focus{border-color:var(--caramel);box-shadow:0 0 0 3px rgba(193,120,79,.15)}
    .wallet-card input[type="tel"].input-error{border-color:#c2483e;box-shadow:0 0 0 3px rgba(194,72,62,.15)}
    .inline-error{color:#c2483e;font-size:.82rem;margin-top:6px;display:none}
    .wallet-options{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:20px}
    .wallet-opt{padding:12px 8px;border:1px solid var(--line);border-radius:10px;text-align:center;font-size:.82rem;font-weight:600;color:var(--mocha);cursor:pointer;transition:.2s}
    .wallet-opt:hover,.wallet-opt.selected{border-color:var(--caramel);color:var(--espresso);background:rgba(193,120,79,.06)}
    .wallet-opt small{display:block;font-weight:400;color:var(--mocha);margin-top:3px;font-size:.74rem}

    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 22px;border-radius:999px;border:1px solid var(--espresso);font-size:.9rem;font-weight:600;transition:all .22s ease;background:transparent;color:var(--espresso)}
    .btn-primary{background:var(--espresso);color:var(--latte)}
    .btn-primary:hover{background:var(--caramel);border-color:var(--caramel);transform:translateY(-2px);box-shadow:0 12px 24px -12px rgba(193,120,79,.7)}
    .btn-block{width:100%}
    .btn:disabled{opacity:.6;pointer-events:none}
    .btn .spinner-sm{display:none;width:18px;height:18px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}
    .btn.loading .spinner-sm{display:inline-block}
    .btn.loading .btn-text{display:none}
    @keyframes spin{to{transform:rotate(360deg)}}
    .back-link{display:inline-flex;align-items:center;gap:6px;margin-top:16px;font-size:.85rem;color:var(--mocha)}
    .back-link:hover{color:var(--caramel)}

    .alert-banner{padding:14px 18px;border-radius:12px;margin-bottom:20px;font-size:.9rem;font-weight:500}
    .alert-error{background:rgba(194,72,62,.08);border:1px solid rgba(194,72,62,.25);color:#8b2e25}
    .alert-warning{background:rgba(212,160,23,.08);border:1px solid rgba(212,160,23,.25);color:#8a6d10}

    .site-footer{background:var(--espresso);color:var(--latte);margin-top:auto}
    .footer-bottom{border-top:1px solid rgba(250,246,239,.14);padding:22px 0;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:rgba(250,246,239,.5);font-size:.85rem}

    @media(max-width:600px){
      .topbar-inner{height:66px}
      .wallet-card{padding:24px}
      .wallet-options{grid-template-columns:1fr}
      .page{padding:40px 0 70px}
    }
  </style>
</head>
<body>

  <header class="topbar">
    <div class="container topbar-inner">
      <a href="/" class="brand"><span class="brand-mark"></span>Box<span>Eseg</span></a>
      <div class="nav-actions">
        <a class="ghost" href="/checkout">Ã¢â€ Â Back to checkout</a>
      </div>
    </div>
  </header>

  <% if (flash && flash.length) { %>
    <div class="flash-stack">
      <% flash.forEach((item) => { %>
        <div class="flash flash-<%= item.type %>"><span><%= item.message %></span><button type="button" data-dismiss aria-label="Dismiss">Ãƒâ€”</button></div>
      <% }) %>
    </div>
  <% } %>

  <main class="page">
    <div class="container">
      <div class="page-head">
        <span class="eyebrow">Wallet payment</span>
        <h1>Enter your wallet details</h1>
      </div>

      <div class="wallet-card">
        <h2>Mobile Wallet</h2>
        <p>Enter the phone number registered with your mobile wallet to complete payment.</p>

        <div id="alertBanner" class="alert-banner" style="display:none"></div>

        <div class="wallet-options">
          <div class="wallet-opt" data-wallet="Vodafone Cash">Vodafone<small>Cash</small></div>
          <div class="wallet-opt" data-wallet="Etisalat Cash">Etisalat<small>Cash</small></div>
          <div class="wallet-opt" data-wallet="Orange Cash">Orange<small>Cash</small></div>
          <div class="wallet-opt" data-wallet="We Pay">We<small>Pay</small></div>
          <div class="wallet-opt" data-wallet="Fawry">Fawry<small>Wallet</small></div>
          <div class="wallet-opt" data-wallet="Other">Other<small>Wallet</small></div>
        </div>

        <form action="/payments/wallet" method="POST" id="walletForm" novalidate>
          <input type="hidden" name="selectedWallet" id="selectedWallet" value="">
          <label>Phone number
            <input type="tel" name="walletNumber" id="walletNumber" placeholder="01010101010" maxlength="11" required autocomplete="tel">
          </label>
          <div class="inline-error" id="phoneError">Please enter a valid Egyptian phone number (11 digits starting with 01).</div>
          <button class="btn btn-primary btn-block" type="submit" id="payBtn">
            <span class="spinner-sm"></span>
            <span class="btn-text">Pay now</span>
          </button>
        </form>
        <a class="back-link" href="/checkout">Ã¢â€ Â Choose a different payment method</a>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="footer-bottom container">
      <span>Ã‚Â© <%= new Date().getFullYear() %> BoxEseg. Stationery for the analog mind.</span>
      <span>Designed &amp; printed with care</span>
    </div>
  </footer>

  <script>
    (function () {
      document.querySelectorAll('[data-dismiss]').forEach(function (b) {
        b.addEventListener('click', function () { b.closest('.flash').remove(); });
      });

      var opts = document.querySelectorAll('[data-wallet]');
      var hidden = document.getElementById('selectedWallet');
      opts.forEach(function (el) {
        el.addEventListener('click', function () {
          opts.forEach(function (o) { o.classList.remove('selected'); });
          el.classList.add('selected');
          hidden.value = el.getAttribute('data-wallet');
        });
      });

      var form = document.getElementById('walletForm');
      var phoneInput = document.getElementById('walletNumber');
      var phoneError = document.getElementById('phoneError');
      var payBtn = document.getElementById('payBtn');
      var alertBanner = document.getElementById('alertBanner');

      phoneInput.addEventListener('input', function () {
        phoneError.style.display = 'none';
        phoneInput.classList.remove('input-error');
      });

      form.addEventListener('submit', function (e) {
        var val = phoneInput.value.trim();
        if (!/^01[0-9]{9}$/.test(val)) {
          e.preventDefault();
          phoneError.style.display = 'block';
          phoneInput.classList.add('input-error');
          phoneInput.focus();
          return;
        }
        payBtn.classList.add('loading');
        payBtn.disabled = true;
      });
    })();
  </script>
</body>
</html>
