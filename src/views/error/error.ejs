<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= statusCode || 500 %> | BoxEseg</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --latte:#FAF6EF; --latte-2:#F0E9DD; --card:#FFFDF8;
      --espresso:#2B2018; --mocha:#6A5446; --caramel:#C1784F; --caramel-deep:#A25E3C;
      --line:rgba(43,32,24,.12);
      --shadow:0 24px 50px -22px rgba(43,32,24,.22);
      --serif:'Playfair Display',Georgia,serif; --sans:'Inter',-apple-system,'Segoe UI',Arial,sans-serif;
      --r:16px;
    }
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:var(--sans);background:var(--latte);color:var(--espresso);min-height:100vh;display:grid;place-items:center;padding:24px;text-align:center;-webkit-font-smoothing:antialiased}
    a{text-decoration:none;color:inherit}
    .brand{display:flex;align-items:center;justify-content:center;gap:10px;font-family:var(--serif);font-size:1.5rem;font-weight:700;margin-bottom:40px}
    .brand-mark{width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,var(--caramel) 50%,var(--espresso) 50%);box-shadow:0 0 0 2px var(--espresso);transform:rotate(-6deg)}
    .brand span{color:var(--caramel)}
    .panel{max-width:600px;padding:56px 44px;background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow)}
    .code{font-family:var(--serif);font-style:italic;font-size:6rem;line-height:1;color:var(--caramel)}
    h1{font-family:var(--serif);font-size:1.9rem;font-weight:600;margin:12px 0 10px}
    .panel > p{color:var(--mocha);margin-bottom:28px;overflow-wrap:break-word}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 26px;border-radius:999px;border:1px solid var(--espresso);font-size:.9rem;font-weight:600;transition:all .22s ease;background:var(--espresso);color:var(--latte)}
    .btn:hover{background:var(--caramel);border-color:var(--caramel);transform:translateY(-2px);box-shadow:0 12px 24px -12px rgba(193,120,79,.7)}
    .error-stack{margin-top:26px;padding:16px;text-align:left;border-radius:12px;background:var(--latte-2);font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:.82rem;color:var(--caramel-deep);white-space:pre-wrap;word-break:break-word;max-height:320px;overflow:auto}
  </style>
</head>
<body>
  <div>
    <a href="/" class="brand"><span class="brand-mark"></span>Box<span>Eseg</span></a>
    <div class="panel">
      <div class="code"><%= statusCode || 500 %></div>
      <h1>Something went wrong.</h1>
      <p><%= message || 'An unexpected error occurred. Our team has been notified.' %></p>
      <a class="btn" href="/">Back home</a>
      <% if (stack) { %>
        <pre class="error-stack"><%= stack %></pre>
      <% } %>
    </div>
  </div>
</body>
</html>
