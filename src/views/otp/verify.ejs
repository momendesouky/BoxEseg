<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <title><%= title %> | BoxEseg</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --latte:#FAF6EF; --latte-2:#F0E9DD; --card:#FFFDF8;
      --espresso:#2B2018; --mocha:#6A5446; --caramel:#C1784F; --caramel-deep:#A25E3C;
      --line:rgba(43,32,24,.12); --line-2:rgba(43,32,24,.26);
      --shadow:0 24px 50px -22px rgba(43,32,24,.22);
      --shadow-sm:0 12px 26px -14px rgba(43,32,24,.18);
      --serif:'Playfair Display',Georgia,serif; --sans:'Inter',-apple-system,'Segoe UI',Arial,sans-serif;
      --r:16px; --r-sm:10px;
    }
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:var(--sans);background:var(--latte);color:var(--espresso);line-height:1.65;-webkit-font-smoothing:antialiased}
    a{text-decoration:none;color:inherit}
    button{font:inherit;cursor:pointer}
    input{font:inherit;color:inherit}
    ::selection{background:var(--caramel);color:#fff}
    .container{width:100%;max-width:1240px;margin:0 auto;padding:0 24px}

    .topbar{position:sticky;top:0;z-index:200;background:rgba(250,246,239,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
    .topbar-inner{display:flex;align-items:center;justify-content:space-between;gap:24px;height:74px}
    .brand{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-size:1.55rem;font-weight:700}
    .brand-mark{width:38px;height:38px;background:url('/images/logo.png') no-repeat center/contain}
    .brand span{color:var(--caramel)}

    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 22px;border-radius:999px;border:1px solid var(--espresso);font-size:.9rem;font-weight:600;transition:all .22s ease;background:transparent;color:var(--espresso)}
    .btn-primary{background:var(--espresso);color:var(--latte)}
    .btn-primary:hover{background:var(--caramel);border-color:var(--caramel);transform:translateY(-2px);box-shadow:0 12px 24px -12px rgba(193,120,79,.7)}
    .btn-outline:hover{background:var(--espresso);color:var(--latte);transform:translateY(-2px)}
    .btn-block{width:100%}
    label{display:grid;gap:7px;font-size:.85rem;font-weight:600}
    input{width:100%;min-height:48px;border:1px solid var(--line-2);border-radius:12px;background:var(--card);padding:10px 14px;outline:none;transition:border-color .2s,box-shadow .2s}
    input:focus{border-color:var(--caramel);box-shadow:0 0 0 3px rgba(193,120,79,.15)}

    .flash-stack{position:fixed;top:90px;right:20px;z-index:400;display:grid;gap:10px;width:min(360px,calc(100% - 40px))}
    .flash{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-radius:12px;background:var(--card);border:1px solid var(--line);box-shadow:var(--shadow-sm);animation:slideIn .35s cubic-bezier(.16,1,.3,1)}
    .flash-success{border-left:4px solid #4c9f70}
    .flash-error{border-left:4px solid #c2483e}
    .flash button{border:0;background:transparent;color:var(--mocha);font-size:1rem}
    @keyframes slideIn{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:none}}

    .page{padding:56px 0 96px}
    .card-shell{max-width:520px;margin:0 auto;background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:36px;box-shadow:var(--shadow-sm)}
    .eyebrow{display:inline-flex;align-items:center;gap:10px;text-transform:uppercase;letter-spacing:.18em;font-size:.74rem;font-weight:600;color:var(--caramel)}
    .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--caramel)}
    .card-shell h1{font-family:var(--serif);font-size:1.9rem;margin-top:14px}
    .card-shell p.hint{margin-top:10px;color:var(--mocha);font-size:.95rem}
    .contact-pill{margin-top:16px;display:inline-flex;align-items:center;gap:8px;padding:8px 14px;background:var(--latte-2);border-radius:999px;font-weight:600;font-size:.9rem}
    .code-input{margin-top:22px;text-align:center;font-size:1.7rem;letter-spacing:.65em;font-weight:700;text-indent:.65em}
    .actions{margin-top:20px;display:grid;gap:12px}
    .resend-row{margin-top:18px;text-align:center;font-size:.88rem;color:var(--mocha)}
    .resend-row button{border:0;background:transparent;color:var(--caramel-deep);font-weight:700;text-decoration:underline;padding:0}
    .resend-row button:disabled{color:var(--mocha);opacity:.55;text-decoration:none;cursor:default}

    .steps{margin-top:26px;display:flex;align-items:center;justify-content:center;gap:10px;font-size:.8rem;color:var(--mocha)}
    .steps span{display:inline-flex;align-items:center;gap:6px}
    .steps .dot{width:22px;height:22px;border-radius:50%;border:1px solid var(--line-2);display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700}
    .steps .done{background:var(--espresso);color:var(--latte);border-color:var(--espresso)}
    .steps .current{border-color:var(--caramel);color:var(--caramel-deep)}

    @media(max-width:600px){
      .page{padding:40px 0 70px}
      .card-shell{padding:24px}
    }
  </style>
</head>
<body>

  <header class="topbar">
    <div class="container topbar-inner">
      <a href="/" class="brand"><span class="brand-mark"></span>Box<span>Eseg</span></a>
    </div>
  </header>

  <% if (flash && flash.length) { %>
    <div class="flash-stack">
      <% flash.forEach((item) => { %>
        <div class="flash flash-<%= item.type %>"><span><%= item.message %></span><button type="button" data-dismiss aria-label="Dismiss">×</button></div>
      <% }) %>
    </div>
  <% } %>

  <main class="page">
    <div class="container">
      <div class="card-shell">
        <span class="eyebrow">Security check</span>
        <h1>Verify it's you.</h1>
        <p class="hint">
          <% if (channel === 'telegram' && !telegramLinked) { %>
            One quick step: open our bot in Telegram and send it the link code below. Your verification code arrives right after.
          <% } else if (channel === 'telegram' || contactType === 'phone') { %>
            We sent a 6-digit code to your Telegram chat. Enter it below to continue.
          <% } else { %>
            We sent a 6-digit code to your email. Enter it below to continue.
          <% } %>
        </p>
        <div class="contact-pill">📧 <%= maskedContact %><% if (channel === 'telegram') { %> · via Telegram<% } %></div>

        <% if (channel === 'telegram' && !telegramLinked) { %>
          <div id="tgLinkBox" data-code="<%= linkCode %>" style="margin-top:22px;background:var(--latte-2);border-radius:12px;padding:20px;text-align:center">
            <strong style="font-size:1rem">1. Open our Telegram bot</strong>
            <p style="font-size:.95rem;color:var(--mocha);margin-top:6px">
              <% if (botUsername) { %>
                <a href="https://t.me/<%= botUsername %>" target="_blank" rel="noopener" style="color:var(--caramel-deep);text-decoration:underline;font-weight:700">@<%= botUsername %></a>
              <% } else { %>
                Search for the <strong>BoxEseg</strong> bot in Telegram
              <% } %>
            </p>
            <strong style="font-size:1rem;display:block;margin-top:14px">2. Send it this code:</strong>
            <div style="display:flex;align-items:center;justify-content:center;gap:10px;margin-top:10px">
              <code style="font-size:1.4rem;font-weight:700;letter-spacing:.18em;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 16px"><%= linkCode %></code>
              <button type="button" data-copy-code class="btn btn-sm btn-outline">Copy</button>
            </div>
            <p id="tgStatus" style="margin-top:14px;font-size:.88rem;font-weight:600;color:var(--mocha)">Waiting for you to send the code…</p>
          </div>
        <% } else { %>
        <form class="actions" method="POST" action="<%= purpose === 'checkout' ? '/checkout/guest/verify' : '/orders/guest/verify' %>">
          <label>Verification code
            <input class="code-input" name="code" inputmode="numeric" pattern="\d{6}" maxlength="6" autocomplete="one-time-code" placeholder="••••••" autofocus required>
          </label>
          <button class="btn btn-primary btn-block" type="submit">Verify & continue</button>
        </form>

        <div class="resend-row">
          Didn't get the code?
          <button type="button" data-resend data-seconds="60" data-action="<%= purpose === 'checkout' ? '/checkout/guest/resend' : '/orders/guest/resend' %>" disabled>Resend in 60s</button>
        </div>
        <% } %>
      </div>
    </div>
  </main>

  <script>
    (function () {
      document.querySelectorAll('[data-dismiss]').forEach((b) => {
        b.addEventListener('click', () => b.closest('.flash').remove());
      });

      // Resend countdown — links to the resend POST route once it hits zero.
      const btn = document.querySelector('[data-resend]');
      if (btn) {
        let left = Number(btn.dataset.seconds || 60);
        const tick = () => {
          if (left <= 0) {
            btn.innerHTML = 'Resend code';
            btn.disabled = false;
            return;
          }
          btn.textContent = 'Resend in ' + left + 's';
          left -= 1;
          setTimeout(tick, 1000);
        };
        tick();
        btn.addEventListener('click', () => {
          if (btn.disabled) return;
          btn.disabled = true;
          left = 60;
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = btn.dataset.action;
          document.body.appendChild(form);
          form.submit();
        });
      }

      // Auto-submit the first OTP digit focus is a nicety; instead we auto-jump.
      const code = document.querySelector('.code-input');
      if (code) {
        code.value = '';
      }

      // Telegram linking: copy button + poll until the guest's chat is linked.
      const tgBox = document.getElementById('tgLinkBox');
      if (tgBox) {
        const status = document.getElementById('tgStatus');
        const copyBtn = document.querySelector('[data-copy-code]');
        if (copyBtn) {
          copyBtn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(tgBox.dataset.code);
              copyBtn.textContent = 'Copied!';
              setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1600);
            } catch (_) {
              copyBtn.textContent = 'Copy manually';
            }
          });
        }

        let polling = true;
        const poll = async () => {
          if (!polling) return;
          try {
            const res = await fetch('/telegram/status?code=' + encodeURIComponent(tgBox.dataset.code), {
              headers: { Accept: 'application/json' },
            });
            const data = await res.json();
            if (data.status === 'sent') {
              polling = false;
              status.textContent = 'Chat linked — sending your verification code…';
              window.location.reload();
              return;
            }
            if (data.status === 'error') {
              polling = false;
              status.textContent = data.message;
              return;
            }
          } catch (_) {
            // network blip — keep polling
          }
          setTimeout(poll, 2500);
        };
        setTimeout(poll, 1500);
      }
    })();
  </script>
</body>
</html>
