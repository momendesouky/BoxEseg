<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <title>Choose a new password | BoxEseg</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --latte:#FAF6EF; --latte-2:#F0E9DD; --card:#FFFDF8;
      --espresso:#2B2018; --mocha:#6A5446; --caramel:#C1784F; --caramel-deep:#A25E3C;
      --line:rgba(43,32,24,.12); --line-2:rgba(43,32,24,.26);
      --shadow:0 24px 50px -22px rgba(43,32,24,.22);
      --shadow-sm:0 12px 26px -14px rgba(43,32,24,.18);
      --serif:'Playfair Display',Georgia,serif; --sans:'Inter',-apple-system,'Segoe UI',Arial,sans-serif;
      --r:16px; --r-sm:10px;
    }
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:var(--sans);background:var(--latte);color:var(--espresso);line-height:1.65;-webkit-font-smoothing:antialiased;min-height:100vh;display:grid;place-items:center;padding:24px}
    a{text-decoration:none;color:inherit}
    button{font:inherit;cursor:pointer}
    input{font:inherit;color:inherit}
    ::selection{background:var(--caramel);color:#fff}
    .wrap{width:100%;max-width:460px}
    .brand{display:flex;align-items:center;justify-content:center;gap:10px;font-family:var(--serif);font-size:1.6rem;font-weight:700;margin-bottom:28px}
    .brand-mark{width:38px;height:38px;background:url('/images/logo.png') no-repeat center/contain}
    .brand span{color:var(--caramel)}
    .panel{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:38px;box-shadow:var(--shadow-sm);text-align:center}
    .eyebrow{display:inline-flex;align-items:center;justify-content:center;gap:10px;text-transform:uppercase;letter-spacing:.18em;font-size:.74rem;font-weight:600;color:var(--caramel)}
    .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--caramel)}
    .panel h1{font-family:var(--serif);font-size:1.9rem;font-weight:600;margin:16px 0 8px}
    .panel .sub{color:var(--mocha);font-size:.95rem;margin-bottom:26px}
    label{display:grid;gap:7px;font-size:.85rem;font-weight:600;text-align:left;margin-bottom:16px}
    input{width:100%;min-height:50px;border:1px solid var(--line-2);border-radius:12px;background:var(--card);padding:10px 16px;outline:none;transition:border-color .2s,box-shadow .2s}
    input:focus{border-color:var(--caramel);box-shadow:0 0 0 3px rgba(193,120,79,.15)}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 24px;border-radius:999px;border:1px solid var(--espresso);font-size:.9rem;font-weight:600;transition:all .22s ease;background:var(--espresso);color:var(--latte);width:100%}
    .btn:hover{background:var(--caramel);border-color:var(--caramel);transform:translateY(-2px);box-shadow:0 12px 24px -12px rgba(193,120,79,.7)}
    .flash-stack{position:fixed;top:20px;right:20px;z-index:400;display:grid;gap:10px;width:min(360px,calc(100% - 40px))}
    .flash{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-radius:12px;background:var(--card);border:1px solid var(--line);box-shadow:var(--shadow-sm)}
    .flash-success{border-left:4px solid #4c9f70}
    .flash-error{border-left:4px solid #c2483e}
    .flash button{border:0;background:transparent;color:var(--mocha);font-size:1rem}
  </style>
</head>
<body>

  <% if (flash && flash.length) { %>
    <div class="flash-stack">
      <% flash.forEach((item) => { %>
        <div class="flash flash-<%= item.type %>"><span><%= item.message %></span><button type="button" data-dismiss aria-label="Dismiss">Ãƒâ€”</button></div>
      <% }) %>
    </div>
  <% } %>

  <div class="wrap">
    <a href="/" class="brand"><span class="brand-mark"></span>Box<span>Eseg</span></a>
    <div class="panel">
      <span class="eyebrow">Secure reset</span>
      <h1>Choose a new password.</h1>
      <p class="sub">Make it memorable Ã¢â‚¬â€ youÃ¢â‚¬â„¢ll be back at your desk in a minute.</p>
      <form action="/auth/reset-password/<%= token %>" method="POST">
        <label>New password
          <input type="password" name="password" autocomplete="new-password" required>
        </label>
        <label>Confirm password
          <input type="password" name="passwordConfirm" autocomplete="new-password" required>
        </label>
        <button class="btn" type="submit">Update password</button>
      </form>
    </div>
  </div>

  <script>
    document.querySelectorAll('[data-dismiss]').forEach((b) => {
      b.addEventListener('click', () => b.closest('.flash').remove());
    });
  </script>
</body>
</html>
