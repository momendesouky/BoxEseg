<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <title>Create account | BoxEseg</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --latte:#FAF6EF; --latte-2:#F0E9DD; --card:#FFFDF8;
      --espresso:#2B2018; --mocha:#6A5446; --caramel:#C1784F; --caramel-deep:#A25E3C;
      --line:rgba(43,32,24,.12); --line-2:rgba(43,32,24,.26);
      --shadow:0 24px 50px -22px rgba(43,32,24,.22);
      --shadow-sm:0 12px 26px -14px rgba(43,32,24,.18);
      --serif:'Playfair Display',Georgia,serif; --sans:'Inter',-apple-system,'Segoe UI',Arial,sans-serif;
      --r:16px; --r-sm:10px;
    }
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:var(--sans);background:var(--latte);color:var(--espresso);line-height:1.65;-webkit-font-smoothing:antialiased}
    a{text-decoration:none;color:inherit}
    img{display:block;max-width:100%}
    button{font:inherit;cursor:pointer}
    input{font:inherit;color:inherit}
    ::selection{background:var(--caramel);color:#fff}
    .container{width:100%;max-width:1240px;margin:0 auto;padding:0 24px}

    .topbar{position:sticky;top:0;z-index:200;background:rgba(250,246,239,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
    .topbar-inner{display:flex;align-items:center;justify-content:space-between;gap:24px;height:74px}
    .brand{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-size:1.55rem;font-weight:700}
    .brand-mark{width:38px;height:38px;background:url('/images/logo.png') no-repeat center/contain}
    .brand span{color:var(--caramel)}
    .top-actions{display:flex;align-items:center;gap:14px}
    .top-actions a{font-size:.9rem;font-weight:600}
    .top-actions a:hover{color:var(--caramel)}

    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 22px;border-radius:999px;border:1px solid var(--espresso);font-size:.9rem;font-weight:600;transition:all .22s ease;background:transparent;color:var(--espresso)}
    .btn-primary{background:var(--espresso);color:var(--latte)}
    .btn-primary:hover{background:var(--caramel);border-color:var(--caramel);transform:translateY(-2px);box-shadow:0 12px 24px -12px rgba(193,120,79,.7)}
    .btn-outline:hover{background:var(--espresso);color:var(--latte);transform:translateY(-2px)}
    label{display:grid;gap:7px;font-size:.85rem;font-weight:600}
    input{width:100%;min-height:50px;border:1px solid var(--line-2);border-radius:12px;background:var(--card);padding:10px 16px;outline:none;transition:border-color .2s,box-shadow .2s}
    input:focus{border-color:var(--caramel);box-shadow:0 0 0 3px rgba(193,120,79,.15)}

    .flash-stack{position:fixed;top:90px;right:20px;z-index:400;display:grid;gap:10px;width:min(360px,calc(100% - 40px))}
    .flash{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-radius:12px;background:var(--card);border:1px solid var(--line);box-shadow:var(--shadow-sm);animation:slideIn .35s cubic-bezier(.16,1,.3,1)}
    .flash-success{border-left:4px solid #4c9f70}
    .flash-error{border-left:4px solid #c2483e}
    .flash button{border:0;background:transparent;color:var(--mocha);font-size:1rem}
    @keyframes slideIn{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:none}}

    .auth{min-height:calc(100vh - 74px);display:grid;place-items:center;padding:64px 0 96px}
    .auth-wrap{display:grid;grid-template-columns:1fr 560px;gap:64px;align-items:center;width:min(1120px,100%)}
    .auth-art{position:relative}
    .auth-art .img{aspect-ratio:4/5;border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow);transform:rotate(-1.5deg)}
    .auth-art .img img{width:100%;height:100%;object-fit:cover}
    .auth-art .stamp{position:absolute;bottom:-16px;left:-14px;background:var(--espresso);color:var(--latte);padding:14px 20px;border-radius:12px;transform:rotate(3deg);box-shadow:var(--shadow)}
    .auth-art .stamp strong{font-family:var(--serif);font-size:1.2rem;display:block}
    .auth-art .stamp span{font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(250,246,239,.6)}
    .eyebrow{display:inline-flex;align-items:center;gap:10px;text-transform:uppercase;letter-spacing:.18em;font-size:.74rem;font-weight:600;color:var(--caramel)}
    .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--caramel)}
    .panel{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:38px;box-shadow:var(--shadow-sm)}
    .panel h1{font-family:var(--serif);font-size:clamp(1.8rem,3vw,2.4rem);font-weight:600;margin:14px 0 8px}
    .panel .sub{color:var(--mocha);font-size:.95rem;margin-bottom:24px}
    .social-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px}
    .social-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;border:1px solid var(--line-2);border-radius:12px;background:var(--latte);font-weight:600;font-size:.88rem;transition:.2s}
    .social-btn:hover{border-color:var(--espresso);background:var(--card)}
    .social-btn svg{width:20px;height:20px}
    .divider{display:flex;align-items:center;gap:14px;color:var(--mocha);font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;margin:6px 0 20px}
    .divider::before,.divider::after{content:"";flex:1;border-top:1px dashed var(--line-2)}
    form{display:grid;gap:16px}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    .span-2{grid-column:span 2}
    .form-links{display:flex;justify-content:space-between;gap:12px;margin-top:18px;font-size:.88rem;flex-wrap:wrap}
    .form-links a{color:var(--mocha);font-weight:600}
    .form-links a:hover{color:var(--caramel-deep)}
    .back-shop{text-align:center;margin-top:20px;font-size:.85rem;color:var(--mocha)}
    .back-shop a{font-weight:700;color:var(--espresso)}
    .back-shop a:hover{color:var(--caramel)}

    @media(max-width:960px){
      .auth-wrap{grid-template-columns:1fr;gap:32px;width:min(520px,100%)}
      .auth-art{display:none}
    }
    @media(max-width:600px){
      .panel{padding:26px}
      .social-grid,.form-grid{grid-template-columns:1fr}
      .span-2{grid-column:span 1}
      .auth{padding:40px 0 70px}
    }
  </style>
</head>
<body>

  <header class="topbar">
    <div class="container topbar-inner">
      <a href="/" class="brand"><span class="brand-mark"></span>Box<span>Eseg</span></a>
      <div class="top-actions">
        <a href="/products">Shop</a>
        <a class="btn btn-sm" href="/auth/login" style="min-height:38px;padding:0 16px;font-size:.83rem;background:var(--espresso);color:var(--latte)">Login</a>
      </div>
    </div>
  </header>

  <% if (flash && flash.length) { %>
    <div class="flash-stack">
      <% flash.forEach((item) => { %>
        <div class="flash flash-<%= item.type %>"><span><%= item.message %></span><button type="button" data-dismiss aria-label="Dismiss">Ãƒâ€”</button></div>
      <% }) %>
    </div>
  <% } %>

  <main class="auth">
    <div class="auth-wrap">
      <div class="auth-art">
        <div class="img">
          <img src="https://images.unsplash.com/photo-1492889971304-ac16ab4a4a5a?auto=format&fit=crop&q=80&w=900" alt="A warm desk with notebooks and a laptop">
        </div>
        <div class="stamp"><strong>Join us</strong><span>your desk awaits</span></div>
      </div>

      <div class="panel">
        <span class="eyebrow">New account</span>
        <h1>Create your BoxEseg profile.</h1>
        <p class="sub">Save your favourite pieces and check out faster next time.</p>

        <div class="social-grid">
          <a class="social-btn" href="/auth/google" aria-label="Continue with Google">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.23c0-.78-.07-1.53-.2-2.23H12v4.22h5.38a4.6 4.6 0 0 1-2 3.02v2.51h3.24c1.9-1.75 2.98-4.33 2.98-7.52z"/><path fill="#34A853" d="M12 22c2.7 0 4.97-.9 6.62-2.44l-3.24-2.51c-.9.6-2.04.95-3.38.95-2.6 0-4.8-1.76-5.58-4.12H3.08v2.59A10 10 0 0 0 12 22z"/><path fill="#FBBC05" d="M6.42 13.88A6 6 0 0 1 6.1 12c0-.65.11-1.29.32-1.88V7.53H3.08A10 10 0 0 0 2 12c0 1.61.39 3.14 1.08 4.47l3.34-2.59z"/><path fill="#EA4335" d="M12 6c1.47 0 2.8.51 3.84 1.5l2.86-2.86A9.6 9.6 0 0 0 12 2a10 10 0 0 0-8.92 5.53l3.34 2.59C7.2 7.76 9.4 6 12 6z"/></svg>
            Google
          </a>
          <a class="social-btn" href="/auth/facebook" aria-label="Continue with Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#1877F2" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.03 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
            Facebook
          </a>
        </div>

        <div class="divider"><span>or with email</span></div>

        <form class="form-grid" action="/auth/register" method="POST">
          <label>First name
            <input type="text" name="firstName" autocomplete="given-name" required>
          </label>
          <label>Last name
            <input type="text" name="lastName" autocomplete="family-name">
          </label>
          <label class="span-2">Email
            <input type="email" name="email" autocomplete="email" placeholder="you@example.com" required>
          </label>
          <label class="span-2">Phone
            <input type="tel" name="phone" autocomplete="tel">
          </label>
          <label>Password
            <input type="password" name="password" autocomplete="new-password" required>
          </label>
          <label>Confirm password
            <input type="password" name="passwordConfirm" autocomplete="new-password" required>
          </label>
          <button class="btn btn-primary span-2" type="submit">Create account</button>
        </form>

        <div class="form-links">
          <span style="color:var(--mocha)">Already registered?</span>
          <a href="/auth/login">Login</a>
        </div>
        <p class="back-shop"><a href="/products">Ã¢â€ Â Continue shopping</a></p>
      </div>
    </div>
  </main>

  <script>
    document.querySelectorAll('[data-dismiss]').forEach((b) => {
      b.addEventListener('click', () => b.closest('.flash').remove());
    });
  </script>
</body>
</html>
